# Copy to deploy/.env and fill in. deploy/.env is git-ignored.
#
# 1. Create a bot with @BotFather and copy its token.
# 2. Add the bot to your group (or message it), then find the chat id:
#    curl https://api.telegram.org/bot<TOKEN>/getUpdates   ("chat":{"id":...})
#    Group ids are negative, e.g. -1001234567890.
VINDICE_TELEGRAM_BOT_TOKEN=
VINDICE_TELEGRAM_CHAT_ID=
# Link target in alert messages. With https:// the session cookie is Secure.
VINDICE_PUBLIC_URL=http://localhost:8080

# First admin, created only when there are no users yet. Leave the password
# empty to have one generated and printed once in the log (make logs).
VINDICE_ADMIN_USERNAME=admin
VINDICE_ADMIN_PASSWORD=
# Session signing key (32+ characters). Empty: generated and kept in ClickHouse.
VINDICE_SESSION_SECRET=
